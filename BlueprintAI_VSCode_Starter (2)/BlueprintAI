@st.cache_resource
def load_model(path, modified_time):
    return YOLO(str(path))


def get_model():
    if not MODEL_PATH.exists():
        return None

    try:
        return load_model(
            str(MODEL_PATH),
            MODEL_PATH.stat().st_mtime
        )
    except Exception as error:
        st.error(f"Could not load model: {error}")
        return None


# =====================================================
# DATASET ZIP EXTRACTION
# =====================================================

def safe_extract_dataset(zip_file):
    """
    Extract a YOLO dataset ZIP while preventing
    ZIP path traversal.
    """

    temporary_dir = APP_DIR / "dataset_upload"
    temporary_dir.mkdir(exist_ok=True)

    with zipfile.ZipFile(zip_file) as archive:

        for member in archive.infolist():

            target = (temporary_dir / member.filename).resolve()

            if not target.is_relative_to(temporary_dir.resolve()):
                raise ValueError(
                    "The ZIP contains an unsafe file path."
                )

        archive.extractall(temporary_dir)

    return temporary_dir


def find_dataset_root(folder):
    """
    Locate the directory containing train/images
    and train/labels, even if the ZIP has an
    additional parent folder.
    """

    for candidate in [folder] + list(folder.rglob("*")):

        if not candidate.is_dir():
            continue

        train_images = candidate / "train" / "images"
        train_labels = candidate / "train" / "labels"

        if train_images.is_dir() and train_labels.is_dir():
            return candidate

    raise ValueError(
        "Could not find train/images and train/labels. "
        "Please upload a YOLO-format dataset."
    )


def install_dataset(zip_file):

    temporary_dir = APP_DIR / "dataset_upload"

    if temporary_dir.exists():
        shutil.rmtree(temporary_dir)

    temporary_dir.mkdir(exist_ok=True)

    extracted = safe_extract_dataset(zip_file)
    root = find_dataset_root(extracted)

    # Support both "valid" and "val"
    if not (root / "val").exists() and (root / "valid").exists():
        (root / "valid").rename(root / "val")

    # Training and validation folders are required
    for split in ["train", "val"]:

        if not (root / split / "images").is_dir():
            raise ValueError(f"Missing {split}/images folder.")

        if not (root / split / "labels").is_dir():
            raise ValueError(f"Missing {split}/labels folder.")

    if DATASET_DIR.exists():
        shutil.rmtree(DATASET_DIR)

    shutil.copytree(root, DATASET_DIR)

    # Generate our own configuration.
    # Dataset class IDs must match CLASSES.
    config = {
        "path": str(DATASET_DIR.resolve()),
        "train": "train/images",
        "val": "val/images",
        "names": {
            index: name for index, name in enumerate(CLASSES)
        }
    }

    if (DATASET_DIR / "test" / "images").is_dir():
        config["test"] = "test/images"

    config_path = APP_DIR / "data.yaml"

    with open(config_path, "w", encoding="utf-8") as file:
        yaml.safe_dump(config, file, sort_keys=False)

    return config_path


# =====================================================
# DATASET VALIDATION
# =====================================================

def validate_dataset():

    errors = []
    summary = {}

    for split in ["train", "val", "test"]:

        image_folder = DATASET_DIR / split / "images"
        label_folder = DATASET_DIR / split / "labels"

        if not image_folder.exists() or not label_folder.exists():

            if split == "test":
                continue

            errors.append(f"Missing {split} images or labels.")
            continue

        images = [
            file for file in image_folder.iterdir()
            if file.suffix.lower() in IMAGE_EXTENSIONS
        ]

        summary[split] = len(images)

        for image in images:

            label = label_folder / (image.stem + ".txt")

            if not label.exists():
                errors.append(f"Missing label: {label.name}")
                continue

            try:

                with Image.open(image) as im:
                    im.verify()

                lines = label.read_text(
                    encoding="utf-8"
                ).splitlines()

                for line_number, line in enumerate(lines, 1):

                    if not line.strip():
                        continue

                    values = line.split()

                    if len(values) != 5:
                        raise ValueError("Expected five YOLO values.")

                    class_value = float(values[0])

                    if not class_value.is_integer():
                        raise ValueError("Class ID must be an integer.")

                    class_id = int(class_value)

                    if not 0 <= class_id < len(CLASSES):
                        raise ValueError(
                            f"Invalid class ID {class_id}."
                        )

                    coords = [float(v) for v in values[1:]]

                    if not all(np.isfinite(v) for v in coords):
                        raise ValueError("Coordinates must be finite.")

                    if not all(0 <= v <= 1 for v in coords):
                        raise ValueError(
                            "YOLO coordinates must be between 0 and 1."
                        )

                    if coords[2] <= 0 or coords[3] <= 0:
                        raise ValueError("Box width and height must be positive.")

                    if (
                        coords[0] - coords[2] / 2 < 0
                        or coords[0] + coords[2] / 2 > 1
                        or coords[1] - coords[3] / 2 < 0
                        or coords[1] + coords[3] / 2 > 1
                    ):
                        raise ValueError("Bounding box extends outside image.")

            except Exception as error:
                errors.append(
                    f"{image.name}, line {line_number if 'line_number' in locals() else '?'}: {error}"
                )

    return summary, errors


# =====================================================
# TRAINING FUNCTION
# =====================================================

def train_model(epochs, image_size, batch_size):

    config_path = APP_DIR / "data.yaml"

    if not config_path.exists():
        raise FileNotFoundError("Upload a dataset first.")

    # GPU is used automatically if CUDA is available.
    import torch

    device = 0 if torch.cuda.is_available() else "cpu"

    st.write(f"Training device: **{device}**")

    # Load pretrained YOLO11 model.
    model = YOLO("yolo11n.pt")

    # Train on the uploaded dataset.
    model.train(
        data=str(config_path),
        epochs=epochs,
        imgsz=image_size,
        batch=batch_size,
        device=device,
        workers=2,
        patience=20,
        pretrained=True,
        project=str(RUN_DIR),
        name="blueprint",
        exist_ok=True,
        plots=True,
        save=True
    )

    best_weights = (
        RUN_DIR /
        "blueprint" /
        "weights" /
        "best.pt"
    )

    if not best_weights.exists():
        raise FileNotFoundError(
            "Training finished but best.pt was not created."
        )

    shutil.copy2(best_weights, MODEL_PATH)

    # Clear cached old model.
    load_model.clear()

    return MODEL_PATH


# =====================================================
# BLUEPRINT IMAGE DETECTION
# =====================================================

def inspect_blueprint(image, model, confidence, image_size):

    rgb = np.array(image.convert("RGB"))

    results = model.predict(
        source=rgb,
        conf=confidence,
        imgsz=image_size,
        verbose=False
    )

    result = results[0]

    # YOLO returns BGR; PIL expects RGB.
    annotated = result.plot()[..., ::-1]

    annotated_image = Image.fromarray(annotated)

    detections = []

    if result.boxes is not None:

        for box in result.boxes:

            class_id = int(box.cls.item())
            score = float(box.conf.item())

            coords = [
                round(float(value), 2)
                for value in box.xyxy[0].tolist()
            ]

            class_name = result.names.get(
                class_id,
                f"class_{class_id}"
            )

            detections.append({
                "Category": class_name,
                "Confidence": round(score, 4),
                "X1": coords[0],
                "Y1": coords[1],
                "X2": coords[2],
                "Y2": coords[3]
            })

    return annotated_image, detections


# =====================================================
# PDF READING
# =====================================================

def read_pdf(pdf_bytes):

    import fitz

    pages = []

    document = fitz.open(
        stream=pdf_bytes,
        filetype="pdf"
    )

    for index, page in enumerate(document):

        pix = page.get_pixmap(
            matrix=fitz.Matrix(2, 2),
            alpha=False
        )

        image = Image.open(
            io.BytesIO(pix.tobytes("png"))
        ).convert("RGB")

        pages.append((
            f"Page {index + 1}",
            image
        ))

    return pages


